generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id    Int                      @id @default(autoincrement()) // Removed the map directive
  name              String       @db.VarChar(200)
  location          String       @db.VarChar(100) // Pre-req
  phone             String       @unique(map: "UK__user_phone") @db.VarChar(50)
  email             String       @db.VarChar(100) // TODO: @unique(map: "UK__user_email")
  password          String       @db.VarChar(100)
  notes             String?      @db.VarChar(500)
  access_level      access_level @default(client)
  designation       String?      @db.VarChar(50)
  pan_id            String?      @db.VarChar(20)
  aadhaar_id        String?      @db.VarChar(20)
  permanent_address String?      @db.VarChar(500)
  is_active         Boolean      @default(true)
  bio               String?
  date_of_birth     DateTime?
  avatar_url        String?

  created_at    DateTime        @default(now())
  created_by    String?
  updated_at    DateTime        @default(now())
  updated_by    String?
  company_user  company_user[]
  tokens        tokens[]
  notifications notifications[]
  managed_tasks       tasks[]     @relation("task_manager")
  deleted_tasks       tasks[]     @relation("task_deleter")
  task_events_done    task_event[] @relation("task_event_actor")
  task_events_target  task_event[] @relation("task_event_target")
  verified_equipments equipment[] @relation("equipment_verifier")
  audit_logs          audit_log[]
}

model company {
  id                  Int       @id @default(autoincrement())
  // sp_id          Int?               @unique(map: "UK__site_sp_id")
  name                String?   @db.VarChar(200)
  branch_name         String?   @db.VarChar(50) // no-foreign-key relationship with smart_meter.id on purpose to avoid circular referencing
  email               String?   @db.VarChar(100) // TODO: @unique(map: "UK__user_email")
  gst_number          String?   @db.VarChar(15)
  service_type        company_service_type?
  amc_type            amc_type?
  start_date          DateTime?
  end_date            DateTime?
  location            String?
  logo                String?   @db.VarChar(300)
  is_active           Boolean   @default(true)
  parent_company_link Int?
  address_link        Int?      
  created_at          DateTime  @default(now())
  created_by          String?
  updated_at          DateTime  @default(now())
  updated_by          String?

  parent       company?       @relation("company_self_reference", fields: [parent_company_link], references: [id], map: "FK__parent_company")
  children     company[]      @relation("company_self_reference")
  address      address?       @relation(fields: [address_link], references: [id])
  equipment    equipment[]
  company_user company_user[]
  service_reports service_report[]

  @@unique([name, branch_name], name: "company_name_branch_name")
}

model company_user {
  user_link    Int
  company_link Int
  assigned_at  DateTime @default(now())
  role         String?  @db.VarChar(50)

  user    user    @relation(fields: [user_link], references: [id])
  company company @relation(fields: [company_link], references: [id])

  @@id([user_link, company_link])
}

model address {
  id           Int      @id@default(autoincrement())
  lat          Decimal? @db.Decimal(10, 5)
  long         Decimal? @db.Decimal(10, 5)
  boundary     Json?
  zoom_level   Decimal? @db.Decimal(10, 5)
  address_line String?  @db.VarChar(255)
  locality     String?  @db.VarChar(255)
  district     String?  @db.VarChar(50)
  city         String?  @db.VarChar(50)
  state        String?  @db.VarChar(30)
  country      String?  @db.VarChar(30)
  pincode      String?  @db.VarChar(10)
  ero_code     String?  @db.VarChar(30)
  area_code    String?  @db.VarChar(30)

  created_at DateTime  @default(now())
  created_by String?
  updated_at DateTime  @default(now())
  updated_by String?
  company    company[]

  @@unique([lat, long, address_line, pincode], name: "address_lat_long_address_line_pincode_key")
}

enum access_level {
  client
  client_admin
  technician
  eg_admin
  eg_super_admin
  others
}

enum company_service_type {
  amc
  non_amc
  regular
}

enum amc_type {
  c_amc
  nc_amc
}

enum hold {
  spare_required
  expert_service_required
  others
}

enum call_type {
  amc_preventive_maintenance
  breakdown
  service
}

enum status {
  open
  hold
  in_progress
  completed
  closed
}

enum tm_frequency {
  daily
  weekly
  biweekly
  monthly
  bi_monthly
  tri_monthly
  quarterly
  semi_annual
  annual
}

enum task_priority {
  low
  medium
  high
  critical
}

enum approval_state {
  requested
  approved
  assigned
  in_service
  completed
  confirmed
  rejected
}

enum equipment_status {
  operational
  under_maintenance
  faulty
  retired
}

enum pm_frequency {
  monthly
  quarterly
  half_yearly
  yearly
}

enum audit_action {
  created
  updated
  deleted
  logged_in
  logged_out
  assigned
}

enum audit_entity {
  user
  task
  amc
  equipment
  auth
  issue_type
}

model equipment {
  id                Int           @id @default(autoincrement())
  name              String
  make              String?
  model             String?
  eg_serial_number String @unique @map("eg_serial_number")
  serial_number    String?                                
  specifications    String?
  image_url         String?
  manufacturer_date DateTime?     @map("manufacturerDate")
  location          String?
  description       String?
  tm_frequency      tm_frequency? @map("tmFrequency")
  company           company?      @relation(fields: [company_link], references: [id])
  company_link      Int?
  tasks             tasks[]
  manual            String?
  created_at        DateTime      @default(now())
  created_by        String?
  updated_at        DateTime      @default(now())
  updated_by        String?
  is_active         Boolean       @default(true)
  status            equipment_status @default(operational)
  type              String?
  installed_at      DateTime?
  verified_at       DateTime?
  verified_by       Int?
  verifier          user?         @relation("equipment_verifier", fields: [verified_by], references: [id], onDelete: SetNull)
  pm_schedules      pm_schedule[]

  @@unique([eg_serial_number, make, model], name: "equipment_eg_serial_number_make_model")
}

model tasks {
  id                   Int           @id @default(autoincrement())
  name                 String?
  description          String?
  call_type            call_type?
  image                images[]
  out_images           String?
  equipment            equipment?    @relation(fields: [equipment_link], references: [id])
  equipment_link       Int?
  ticket_no            String        @unique(map: "UK__ticket_no")
  otp                  String
  feedback             String?
  action_taken         String?
  req_details          String?
  follow_up            Boolean?
  action_req_details   String?
  service_satisfactory Boolean?
  is_running_smoothly  Boolean?
  notes                String?
  rating               Int?
  status               status?
  task_user            task_user[]
  created_at           DateTime      @default(now())
  created_by           String?
  updated_at           DateTime      @default(now())
  updated_by           String?
  hold_reason          hold_reason[]
  priority             task_priority  @default(medium)
  approval             approval_state @default(requested)
  manager_link         Int?
  manager              user?          @relation("task_manager", fields: [manager_link], references: [id], onDelete: SetNull)
  due_date             DateTime?
  escalated            Boolean        @default(false)
  escalation_reason    String?
  assigned_at          DateTime?
  accepted_at          DateTime?
  started_at           DateTime?
  resolved_at          DateTime?
  closed_at            DateTime?
  resolution_notes     String?
  rejection_reason     String?
  contact_name         String?
  contact_phone        String?
  address              String?
  location             String?
  issue_type_link      Int?
  issue_type           issue_type?    @relation(fields: [issue_type_link], references: [id], onDelete: SetNull)
  events               task_event[]
  deleted_at           DateTime?
  deleted_by           Int?
  deleter              user?          @relation("task_deleter", fields: [deleted_by], references: [id], onDelete: SetNull)
  delete_reason        String?
  pm_generated         pm_generated_task[]
}

/// Issue types offered when raising a task. Rows with a call_type are the
/// three built-in types the older apps still send by key.
/// One step on a ticket's timeline (raised, assigned, started, hold, ...).
model task_event {
  id          Int      @id @default(autoincrement())
  task_link   Int
  task        tasks    @relation(fields: [task_link], references: [id], onDelete: Cascade)
  event       String   @db.VarChar(30)
  actor_link  Int?
  actor       user?    @relation("task_event_actor", fields: [actor_link], references: [id], onDelete: SetNull)
  actor_name  String
  actor_role  String
  target_link Int?
  target      user?    @relation("task_event_target", fields: [target_link], references: [id], onDelete: SetNull)
  target_name String?
  note        String?
  created_at  DateTime @default(now())

  @@index([task_link, created_at])
}

model issue_type {
  id         Int        @id @default(autoincrement())
  name       String     @unique @db.VarChar(60)
  call_type  call_type?
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now())
  created_by String?
  updated_at DateTime   @default(now())
  updated_by String?
  tasks      tasks[]
}

model images {
  id      Int    @id @default(autoincrement())
  url     String
  taskId  Int
  task    tasks  @relation(fields: [taskId], references: [id])
}

model hold_reason {
  id                Int      @id @default(autoincrement())
  hold              hold
  is_active         Boolean @default(false)
  spare_part_number String?
  image             String?
  reason            String?
  created_at        DateTime @default(now())
  created_by        String?
  updated_at        DateTime @default(now())
  updated_by        String?

  task_link Int
  task      tasks @relation(fields: [task_link], references: [id])

  @@unique([hold, spare_part_number, task_link], name: "hold_spare_part_number_task_link_key")
}

model task_user {
  id              Int      @id @default(autoincrement())
  technician_link Int?
  client_link     Int
  task_link       Int
  task            tasks    @relation(fields: [task_link], references: [id])
  status          status   @default(open)
  reason          String?
  created_at      DateTime @default(now())
  created_by      String?
  updated_at      DateTime @default(now())
  updated_by      String?

  @@unique([technician_link, client_link, task_link, status], name: "task_user_technician_link_client_link_task_link_status")
}

model tokens {
  id        Int    @id @default(autoincrement())
  fcm_id    String
  device_id String
  user_link Int
  user      user   @relation(fields: [user_link], references: [id])

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @default(now())
  updated_by String?

  @@unique([device_id, fcm_id, user_link])
}

model notifications {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  image_url   String?
  task_link   Int?
  is_read     Boolean @default(false)
  user_link   Int
  user        user    @relation(fields: [user_link], references: [id])

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @default(now())
  updated_by String?
}

model service_report {
  id                              Int       @id @default(autoincrement())
  service_report_number           String    @unique
  task_id                         String?   @db.VarChar(100)
  company_link                    Int?
  company_name                    String    @db.VarChar(200)
  company_branch                  String?   @db.VarChar(100)
  location                        String?   @db.VarChar(300)
  company_email                   String?   @db.VarChar(100)
  raised_by_name                  String?   @db.VarChar(200)
  raised_by_phone                 String?   @db.VarChar(50)
  raised_by_email                 String?   @db.VarChar(100)
  raised_by_note                  String?   @db.VarChar(300)
  technician_name                 String?   @db.VarChar(200)
  technician_phone                String?   @db.VarChar(50)
  technician_note                 String?   @db.VarChar(300)
  equipment_name                  String?   @db.VarChar(200)
  equipment_make                  String?   @db.VarChar(200)
  equipment_model                 String?   @db.VarChar(200)
  equipment_serial_number         String?   @db.VarChar(200)
  equipment_eg_serial_number      String?   @db.VarChar(200)
  equipment_location              String?   @db.VarChar(300)
  call_type                       String?   @db.VarChar(100)
  issue                           String?   @db.VarChar(500)
  issue_description               String?
  service_details                 String?
  timeline_events                 Json?
  customer_serviced_to_satisfaction String? @db.VarChar(50)
  equipment_running_smoothly      String?   @db.VarChar(50)
  customer_comments               String?
  rating                          String?   @db.VarChar(50)
  cost                            Decimal?  @db.Decimal(12, 2)
  status                          String    @default("Not Started") @db.VarChar(50)
  generated_at                    DateTime?
  created_at                      DateTime  @default(now())
  created_by                      String?
  updated_at                      DateTime  @default(now())
  updated_by                      String?
  company                         company?  @relation(fields: [company_link], references: [id])
}

model audit_log {
  id          Int          @id @default(autoincrement())
  actor_link  Int?
  actor_name  String
  actor_role  String
  action      audit_action
  entity      audit_entity
  entity_id   String?
  entity_name String
  details     String?
  created_at  DateTime     @default(now())
  actor       user?        @relation(fields: [actor_link], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([actor_link])
}

model pm_schedule {
  id             Int                 @id @default(autoincrement())
  equipment_link Int
  frequency      pm_frequency
  next_due       DateTime
  is_active      Boolean             @default(true)
  created_at     DateTime            @default(now())
  updated_at     DateTime            @default(now())
  created_by     String?
  equipment      equipment           @relation(fields: [equipment_link], references: [id], onDelete: Cascade)
  generated      pm_generated_task[]

  @@index([equipment_link])
}

model pm_generated_task {
  id            Int         @id @default(autoincrement())
  schedule_link Int
  task_link     Int?
  due_date      DateTime
  generated_at  DateTime    @default(now())
  schedule      pm_schedule @relation(fields: [schedule_link], references: [id], onDelete: Cascade)
  task          tasks?      @relation(fields: [task_link], references: [id], onDelete: SetNull)

  @@unique([schedule_link, due_date])
}
